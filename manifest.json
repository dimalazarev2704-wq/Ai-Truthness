{
  "manifest_version": 3,
  "name": "TruthCheck - AI Answer & Claim Verifier",
  "version": "1.0.0",
  "description": "Select any text or check AI chatbot answers (ChatGPT, Claude, Gemini) for factual accuracy using live web search.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthCheck"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
